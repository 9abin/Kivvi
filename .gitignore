# 비밀 정보 (API 키, DB 암호)
.env
.env.*
!.env.example

# setup-agent.sh가 받아오는 개인용 에이전트 설정 (팀 공용 저장소에 올리지 않음)
/AGENTS.md
/CLAUDE.md
/.github/

# --- work/261007 (개정안 작성 에이전트) ---
data/*
!data/.gitkeep
!data/manual/
*.hwp
*.hwpx
*.db
*.sqlite
~$*
.venv/
__pycache__/
.pytest_cache/
.serena/

/out/*
!/out/aliases.json
!/out/chunks.jsonl
!/out/cite_review.csv
!/out/text/
!/out/*_review.json
# 외부 기관 배경 자료(RFP 원본 등): 재배포 권한 불명이라 저장소에 넣지 않는다
info/

# 원문·외부 자료 묶음 (KVIC 저작물 등)
*.zip
# 이미지에만 들어가는 데이터 (git 제외)
db/seed/

# --- RAG 챗봇 (옛 rag_pipeline) ---
# 외부 법령 DB (팀원이 따로 전달하는 바이너리라 git에 안 올림)
data/manual/law_rag*.sqlite3
backups/
# N-set·190문항 평가 실행 기록 (결과 파일, 코드 아님)
eval/n_set/runs/
eval/answer_runs/
# 평가 검수 artifact용 임시 export
review_data.json

# 에이전트 평가 문항 중 규정 원문 문장이 들어 있는 것 (KVIC 저작물). 시드로 다시 만든다:
#   scripts/eval_inject.py --seed N, scripts/eval_spell.py make, scripts/eval_precision.py make (판정 중인 csv는 로컬에만)
/eval/agent/inject_s*.jsonl
/eval/agent/spell_s*.jsonl
/eval/agent/precision_sample*.csv
/eval/agent/term_sample.csv
/eval/agent/neighbor_sample.csv

# 화면 글꼴 파일 (app/web/fonts/README.md)
*.woff2
/eval/agent/change_gold_s[2-9].jsonl
/eval/agent/nl_requests_ext.jsonl
/eval/agent/nl_requests_ext_*.jsonl
# 조합 실험 결과 (src/combo): 문서 벡터와 결과 파일은 각자 PC에서 만들고 올리지 않는다
eval/combo/
eval/combo_smoke/
eval/combo_final/

# 영향 평가 라벨 키트의 규정 원문 사본 (KVIC 저작물: 원문은 ALIO 링크로 복원, 저장소에 올리지 않는다)
eval/impact_label_kit*/규정/

# Explicitly shared ontology snapshots and local experiment runtime files.
!/eval/four_domain/domain_ontology.reviewed.db
!/eval/four_domain/hyujik-user-original.db
/eval/four_domain/.cache/
/eval/four_domain/runs/
/eval/four_domain/single_change/runs/
